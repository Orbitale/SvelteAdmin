{
	"name": "@orbitale/svelte-admin",
	"version": "0.18.0",
	"description": "(prototype) Crud base for Svelte projects",
	"repository": "git@github.com:Orbitale/SvelteAdmin",
	"author": "Alex \"Pierstoval\" Rock <alex@orbitale.io>",
	"license": "LGPL-3.0-or-later",
	"keywords": [
		"svelte"
	],
	"scripts": {
		"build": "vite build && pnpm run prepack",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"create:field": "node bin/create_field.mjs",
		"create:theme": "node bin/create_theme.mjs",
		"dev": "vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test:unit": "vitest",
		"test": "vitest --run",
		"typedoc": "typedoc --options typedoc.json --readme none"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./themes/svelte": "./dist/themes/svelte/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"directories": {
		".": "./dist/",
		"/themes/svelte/": "./dist/themes/svelte"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"./src/lib/*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"peerDependencies": {
		"carbon-components-svelte": "^0.111.1",
		"carbon-icons-svelte": "^13.14.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.6.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/svelte-core": "^1.1.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.6",
		"@vitest/browser-playwright": "^5.0.1",
		"carbon-components-svelte": "^0.112.0",
		"carbon-icons-svelte": "^13.15.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"luxon": "^3.7.2",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-i18n": "^4.0.1",
		"typedoc": "^0.28.20",
		"typedoc-plugin-mdn-links": "^5.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"type": "module"
}
